// Mechanical Team Tool Inventory — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  INVENTORY_MANAGER
  TEAMMATE
}

enum ToolStatus {
  AVAILABLE
  LOW_STOCK
  FINISHED
  RETIRED
}

enum InventoryAction {
  CREATED
  QUANTITY_UPDATED
  STATUS_CHANGED
  LOCATION_CHANGED
  DETAILS_UPDATED
  RESTOCKED
}

enum RequestStatus {
  REQUESTED
  APPROVED
  ORDERED
  RECEIVED
  REJECTED
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketEventType {
  OPENED
  STATUS_CHANGED
  ASSIGNED
  COMMENT
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TEAMMATE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  toolsCreated      Tool[]               @relation("ToolCreatedBy")
  inventoryLogs     InventoryLog[]       @relation("LogPerformedBy")
  requestsMade      ProcurementRequest[] @relation("RequestRequestedBy")
  requestsApproved  ProcurementRequest[] @relation("RequestApprovedBy")
  procurementEvents ProcurementEvent[]   @relation("ProcurementEventActor")
  ticketsOpened     RepairTicket[]       @relation("TicketOpenedBy")
  ticketsAssigned   RepairTicket[]       @relation("TicketAssignedTo")
  ticketEvents      TicketEvent[]        @relation("TicketEventActor")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Where things live. Self-referencing so locations nest: Room > Shelf > Bin.
// ---------------------------------------------------------------------------

model StorageLocation {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  description String?
  parentId    String?

  // Each place stores things its own way. A drawer unit wants a drawer
  // number, a shelf wants a row, a warehouse floor wants a free description.
  // Holding that guidance on the location means the item form can ask the
  // right question, and new locations can set their own without a code change.
  detailLabel    String?
  detailHint     String?
  detailRequired Boolean @default(false)

  // Who to ask about things kept here. Used for the office, where items are
  // on someone's desk rather than in a labelled place.
  contactName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   StorageLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children StorageLocation[] @relation("LocationHierarchy")
  tools    Tool[]

  @@index([parentId])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Tool {
  id       String @id @default(cuid())
  name     String
  category String

  quantity Int    @default(0)
  unit     String @default("pcs")

  // Quantity at or below this flips the tool to LOW_STOCK automatically.
  lowStockThreshold Int @default(1)

  status ToolStatus @default(AVAILABLE)
  notes  String?

  storageLocationId String?

  // Exactly where inside that location: "Locker 04", "Row 3", "Box 12".
  // Shown to everyone, including the public search, because knowing the room
  // is not the same as being able to put your hand on the thing.
  locationDetail String?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("ToolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  logs     InventoryLog[]
  requests ProcurementRequest[]
  tickets  RepairTicket[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([storageLocationId])
  @@index([updatedAt])
}

// Append-only audit trail. One row per change, never updated or deleted.
model InventoryLog {
  id     String          @id @default(cuid())
  toolId String
  action InventoryAction

  // Which field changed, and what it went from and to. Stored as text so a
  // single table can record quantity, status and location changes alike.
  field    String?
  oldValue String?
  newValue String?
  note     String?

  performedById String?
  createdAt     DateTime @default(now())

  tool        Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  performedBy User? @relation("LogPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([toolId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Procurement: Requested -> Approved -> Ordered -> Received (or Rejected)
// ---------------------------------------------------------------------------

model ProcurementRequest {
  id String @id @default(cuid())

  // Null when someone requests an item that is not in inventory yet.
  toolId String?

  itemName          String
  quantityRequested Int
  unit              String        @default("pcs")
  reason            String?
  urgency           Urgency       @default(NORMAL)
  status            RequestStatus @default(REQUESTED)

  requestedById String
  approvedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tool        Tool?              @relation(fields: [toolId], references: [id], onDelete: SetNull)
  requestedBy User               @relation("RequestRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?              @relation("RequestApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  events      ProcurementEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([requestedById])
}

model ProcurementEvent {
  id         String         @id @default(cuid())
  requestId  String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  note       String?
  actorId    String?
  createdAt  DateTime       @default(now())

  request ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?              @relation("ProcurementEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

// ---------------------------------------------------------------------------
// Repair tickets: Open -> In Progress -> Resolved (or Closed)
// ---------------------------------------------------------------------------

model RepairTicket {
  id          String         @id @default(cuid())
  toolId      String
  title       String
  description String
  severity    TicketSeverity @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  openedById   String
  assignedToId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  tool       Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)
  openedBy   User          @relation("TicketOpenedBy", fields: [openedById], references: [id])
  assignedTo User?         @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  events     TicketEvent[]

  @@index([status])
  @@index([toolId])
  @@index([assignedToId])
  @@index([createdAt])
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  type      TicketEventType
  fromValue String?
  toValue   String?
  note      String?
  actorId   String?
  createdAt DateTime        @default(now())

  ticket RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?        @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
