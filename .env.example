# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Postgres connection string.
#   Local development: run `npm run db:start` and paste the URL it prints.
#   Production: the connection string from Neon, Supabase or Railway.
DATABASE_URL=""

# Only needed for local development, where `npm run db:start` prints it too.
# Leave this empty in production.
SHADOW_DATABASE_URL=""

# Signs the login cookie. Must be set, and must differ between local and
# production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
